# Copie para ".env" e preencha com as suas chaves do Azure Cognitive Services.
# (o arquivo .env nao deve ser versionado - ja esta no .gitignore)
#
# Recomendado: criar os recursos INDIVIDUAIS com tier F0 (Free):
#   - Azure AI Speech    -> transcricao (fala em texto)
#   - Azure AI Language   -> Text Analytics (sentimento + entidades)

# ---- Azure AI Speech (usado por transcrever_audio) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2

# ---- Azure AI Language / Text Analytics (usado por analisar_texto_azure) ----
AZURE_TEXT_ANALYTICS_KEY=
AZURE_TEXT_ANALYTICS_REGION=westus2
# Recursos NOVOS (Azure AI Language) NAO aceitam o endpoint regional legado
# e exigem o endpoint proprio do recurso. Ex.:
#   AZURE_TEXT_ANALYTICS_ENDPOINT=https://<nome-do-recurso>.cognitiveservices.azure.com/
# Deixe VAZIO apenas se usar um recurso multi-service legado (endpoint por regiao).
AZURE_TEXT_ANALYTICS_ENDPOINT=
